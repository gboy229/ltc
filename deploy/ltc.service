[Unit]
Description=LTC server
After=network.target mysql.service redis-server.service

[Service]
Type=simple
# 直接以 root 运行，避免切换运行用户后 logs/storage/session 权限问题。
# 如需降权：改成 User=www / Group=www，并执行：
#   chown -R www:www /opt/ltc/{logs,storage,resource/public/attachment}
User=root
Group=root
WorkingDirectory=/opt/ltc
ExecStart=/opt/ltc/main
Restart=always
RestartSec=5
LimitNOFILE=65535
# 敏感配置走环境变量，不写进 config.yaml
EnvironmentFile=-/opt/ltc/.env

[Install]
WantedBy=multi-user.target
